APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Localization rollout. Keep dual-write and legacy fallback enabled until the
# new reader has operated stably for at least one release cycle.
LOCALIZATION_CONTENT_READER=new
LOCALIZATION_CONTENT_DUAL_WRITE=true
LOCALIZATION_CONTENT_LEGACY_FALLBACK=true
# legacy | canary | all
LOCALIZATION_MENU_ROLLOUT_STAGE=all

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Optional connection to the main HT Vietnam website database.
DB_HOST_HT=127.0.0.1
DB_PORT_HT=3306
DB_DATABASE_HT=
DB_USERNAME_HT=
DB_PASSWORD_HT=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Required when running DatabaseSeeder outside local/testing for the first time.
AIO_SYSTEM_OWNER_PASSWORD=
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SMS_DRIVER=log
SMS_LOG_CHANNEL=sms
SMS_ENDPOINT=
SMS_API_KEY=
SMS_FROM="AIO"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


#https://sudes-logistics.mysapo.net/
#https://lofi-furniture.mysapo.net/
#https://cool-my-home.mysapo.net/
#https://lofi-company.mysapo.net/
