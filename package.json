        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "antd": "^5.28.0",
        "ckeditor5": "^48.0.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.14.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@playwright/test": "^1.54.2",
        "@vitejs/plugin-react": "^5.0.0",
        "axios": "^1.11.0",
        "babel-plugin-import": "^1.13.8",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
