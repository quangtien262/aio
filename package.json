{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --force",
        "test:browser:install": "playwright install chromium",
        "test:browser:admin-translations": "playwright test tests/browser/admin-theme-translations.spec.js",
        "test:browser:admin-translations:ci": "npm run build && start-server-and-test \"php artisan serve --host=127.0.0.1 --port=8000\" http://127.0.0.1:8000/admin/login \"playwright test tests/browser/admin-theme-translations.spec.js\""
    },
    "dependencies": {
        "@ant-design/v5-patch-for-react-19": "^1.0.3",
