{
  "name": "EC901 Tempo Watch Commerce",
  "key": "EC901",
  "version": "1.0.0",
  "description": "Theme thương mại điện tử đồng hồ cao cấp với slider, flash deal, danh mục, bộ sưu tập, thương hiệu, đánh giá và tin tức.",
  "website_type": "ecommerce",
  "parent": null,
  "preview": {
    "thumbnail": "ec901.png",
    "cover": "ec901.png"
  },
  "blocks": [
    "hero-slider",
    "flash-deals",
    "featured-categories",
    "best-sellers",
    "gender-banners",
    "promotion-mosaic",
    "product-grid",
    "mini-promotions",
    "luxury-collection",
    "testimonials",
    "featured-brands",
    "latest-posts",
    "benefits"
  ],
  "supports": {
    "dark_mode": false,
    "multi_homepage": true,
    "custom_css": true,
    "block_mapping": true
