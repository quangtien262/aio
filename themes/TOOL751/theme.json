{
  "name": "TOOL751 Bee Tools Store",
  "key": "TOOL751",
  "version": "1.0.0",
  "description": "Theme bán dụng cụ cơ khí vàng đen với header thông tin, hero khuyến mãi, dải danh mục và Catalog CMS.",
  "website_type": "ecommerce",
  "requires_modules": ["catalog", "cms"],
  "parent": null,
  "preview": {
    "thumbnail": "preview-tool751.png",
    "cover": "cover-tool751.png"
  },
  "blocks": [
    "tool751-hero",
    "tool751-category-icons",
    "tool751-sale-products",
    "tool751-compact-products",
    "tool751-category-products",
    "tool751-news",
    "tool751-partners"
  ],
  "supports": {
    "multi_homepage": true,
    "custom_css": true,
    "block_mapping": true,
    "responsive_navigation": true
  },
  "localization": {
    "default_locale": "vi",
    "supported_locales": ["vi", "en"]
  },
  "demo": {
    "content_path": "demo/content",
    "settings_path": "demo/settings",
    "default_preset": "tool751-bee-store"
  }
}
