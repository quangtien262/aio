{
  "name": "Danh mục hàng hóa dùng chung",
  "key": "merchandise",
  "test_data_provider": "Modules\\Merchandise\\Services\\MerchandiseTestDataProvider",
  "version": "0.2.2",
  "description": "Danh mục SKU, mã vạch và quy cách dùng chung cho Retail, Kho và Mua hàng.",
  "website_type": [
    "backoffice",
    "ecommerce",
    "corporate",
    "service",
    "news",
    "landingpage"
  ],
  "dependencies": [],
  "provides": {
    "merchandise.skus.read.v1": {
      "introduced_version": "0.1.0"
    },
    "merchandise.skus.manage.v1": {
      "introduced_version": "0.1.0"
    },
    "merchandise.variants.read.v1": {
      "introduced_version": "0.2.0"
    },
    "merchandise.variants.manage.v1": {
      "introduced_version": "0.2.0"
    }
  },
  "permissions": [
    "merchandise.view",
    "merchandise.manage",
    "merchandise.import"
  ],
  "hooks": [
    "Modules\\Merchandise\\Hooks\\MerchandiseLifecycleHook"
  ],
  "lifecycle_state_provider": "Modules\\Merchandise\\Services\\MerchandiseRuntimeState",
  "menus": [],
  "package": {
    "migrations": [
      "database/migrations"
    ]
  },
  "lifecycle": {
    "install": true,
    "enable": true,
    "disable": true,
    "upgrade": true,
    "uninstall": false
  },
  "changelog": [
    {
      "version": "0.2.2",
      "date": "2026-10-21",
      "notes": [
        "Bỏ cấu hình số lẻ riêng của SKU/đơn vị; giữ số lượng và quy đổi chính xác tối đa sáu chữ số theo nền kho."
      ]
    },
    {
      "version": "0.2.1",
      "date": "2026-10-21",
      "notes": [
        "Danh mục đơn vị theo catalog; quản lý đơn vị tại form hàng hóa Retail, giữ nguyên mã đơn vị đã sử dụng."
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-21",
      "notes": [
        "Additive company-owned manufacturing contracts; preserve existing consumer semantics."
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-10-20",
      "notes": [
        "Master hàng hóa dùng chung, barcode và quy đổi chính xác; import có kiểm tra trước khi ghi."
      ]
    }
  ]
}
